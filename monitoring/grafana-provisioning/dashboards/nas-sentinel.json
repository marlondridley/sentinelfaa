{
  "uid": "nas-sentinel",
  "title": "NAS FeedOps Sentinel — PCT TRACON",
  "tags": ["nas", "faa", "swim", "pct"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "HITL Queue Depth",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "nas_hitl_queue_depth", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Events Ingested (5m rate)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(nas_events_ingested_total[5m]))", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Critical Alerts (5m)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(nas_alerts_triggered_total{severity=\"CRITICAL\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Validation Failure Rate",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(nas_events_validated_total{status=\"FAILED\"}[5m])) / sum(rate(nas_events_validated_total[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Alerts by Severity (per minute)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (severity) (rate(nas_alerts_triggered_total[1m]))", "legendFormat": "{{severity}}", "refId": "A"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Gate Decisions by Risk Tier",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (risk_tier) (rate(nas_gate_decisions_total[1m]))", "legendFormat": "{{risk_tier}}", "refId": "A"}]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Airport Overall Status (0=OK ... 4=DISCONNECTED)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "nas_airport_overall_status", "legendFormat": "{{airport}}", "refId": "A"}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM Call Latency (p95)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (agent, le) (rate(nas_llm_call_duration_seconds_bucket[5m])))", "legendFormat": "{{agent}} p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ]
}
