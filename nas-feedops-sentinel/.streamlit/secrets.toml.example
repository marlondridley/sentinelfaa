# .streamlit/secrets.toml.example
#
# Copy this file to .streamlit/secrets.toml (same directory, next to this
# .example file) and fill in real values from your Keycloak instance.
#
# secrets.toml itself is gitignored (see the repo-root .gitignore's
# ".streamlit/" entry) -- git will never see it, so it's safe to put real
# credentials there. Never rename/commit the real file, and never paste a
# real client_secret or cookie_secret into an issue, PR, or chat.
#
# HOW THIS IS USED (changed -- read this if you are following older notes)
#
# The dashboard no longer redirects the browser to Keycloak's hosted login
# page. It renders its own sign-in form (dashboard/lib/login.py) and
# exchanges the credential at this realm's token endpoint using the OAuth2
# direct access grant, then verifies the returned ID token against the
# realm's published signing keys. src/keycloak_auth.py's module docstring
# states exactly what that design gains, what it gives up relative to the
# redirect flow, and why the audit trail records `[keycloak-password]`
# rather than `[oidc]`.
#
# Consequences for this file:
#   * client_id, client_secret and server_metadata_url are REQUIRED. They
#     are the three values dashboard/lib/login.py reads.
#   * redirect_uri and cookie_secret are NOT used by the in-app form. They
#     are kept because they cost nothing and because reverting to the
#     redirect flow should not require re-deriving them.
#   * The client must have "Direct access grants" enabled in Keycloak.
#     keycloak/realm-nas-sentinel.json sets it for a fresh import, and
#     scripts/Setup-Keycloak.ps1 reconciles it on a realm that was imported
#     before that flag existed.
#
# If this file is absent entirely, dashboard/lib/page_setup.py falls back to
# the self-declared "Operator ID / Callsign" text box rather than refusing to
# load, and every decision that operator makes is stamped `[self-declared]`
# in action_audit_log (see src/auth.py's PrincipalSource / format_actor()).
#
# The provider name in the [auth.<name>] table below ("keycloak") is the key
# dashboard/lib/login.py looks up -- don't rename that section.
#
# Legacy note, still accurate for the redirect path:
# This file is read by Streamlit's built-in OIDC auth (st.login / st.user /
# st.logout), which dashboard/lib/page_setup.py's require_oidc_auth() and
# render_operator_identity_sidebar() call on every page (see bootstrap_page()
# in that same file). If st.secrets has no "auth" table at all -- i.e. this
# file is absent -- require_oidc_auth() is a deliberate no-op: the dashboard
# falls back to the self-declared "Operator ID / Callsign" text box instead
# of refusing to load. Configuring this file is what upgrades every
# Execution Gate approve/reject decision from
# "jsmith (Watch Officer) [self-declared]" to
# "jsmith (Watch Officer) [oidc]" in action_audit_log (see src/auth.py's
# PrincipalSource / format_actor()).
#

[auth]
# Streamlit's fixed OIDC callback path is always /oauth2callback. Set the
# host:port to wherever a BROWSER actually loads this dashboard from:
#   - `streamlit run dashboard/app.py` directly           -> localhost:8501
#   - the dashboard container via docker-compose.yml       -> whatever host
#     you have port 8501 mapped to (localhost:8501 by default here)
redirect_uri = "http://localhost:8501/oauth2callback"

# Any long random string; Streamlit uses it to sign the session cookie.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"

[auth.keycloak]
# Keycloak admin console -> your realm -> Clients -> create a new
# confidential client for this app -> Credentials tab.
client_id = "nas-feedops-sentinel"
client_secret = "REPLACE_WITH_CLIENT_SECRET_FROM_KEYCLOAK"

# Your realm's OIDC discovery document, over HTTPS (Keycloak serves nothing
# else, and the dashboard refuses an http:// identity URL: the sign-in sends
# the operator's password). This URL is fetched by the Streamlit PROCESS
# itself, not the browser -- so it needs to resolve from wherever that
# process actually runs:
#   - the dashboard running AS a container on the docker-compose network
#     (the normal case) -> the service name and Keycloak's own port:
#       https://keycloak:8443/realms/<your-realm>/.well-known/openid-configuration
#   - `streamlit run` directly on your machine, against the host-mapped port ->
#       https://localhost:8081/realms/<your-realm>/.well-known/openid-configuration
server_metadata_url = "https://keycloak:8443/realms/nas-sentinel/.well-known/openid-configuration"

# The authority that signed Keycloak's certificate: tls/edge-ca.crt, issued by
# src/devcert.py, published to tls/trust/ and mounted into the dashboard
# container at this path. Leave
# it out to use the system trust store (an internal PKI the OS already trusts);
# KEYCLOAK_CA_FILE in the environment is used when this is absent.
ca_file = "/run/tls/edge-ca.crt"
