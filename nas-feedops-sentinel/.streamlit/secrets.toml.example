# .streamlit/secrets.toml.example
#
# Copy this file to .streamlit/secrets.toml (same directory, next to this
# .example file) and fill in real values from your Keycloak instance.
#
# secrets.toml itself is gitignored (see the repo-root .gitignore's
# ".streamlit/" entry) -- git will never see it, so it's safe to put real
# credentials there. Never rename/commit the real file, and never paste a
# real client_secret or cookie_secret into an issue, PR, or chat.
#
# HOW THIS IS USED
#
# "Sign in with Keycloak" (dashboard/lib/login.py) calls st.login(): the browser
# goes to the realm's own login page (authorization code flow with PKCE) and
# comes back to redirect_uri. Streamlit validates the ID token and keeps the
# identity in a cookie signed with cookie_secret; the dashboard never sees a
# password. src/keycloak_auth.py says what Sentinel decides itself (which realm
# roles count, how long a sign-in lasts).
#
# Consequences for this file:
#   * redirect_uri, cookie_secret, client_id, client_secret and
#     server_metadata_url are ALL required. The dashboard refuses to sign anyone
#     in while any of them is missing or still a REPLACE_WITH placeholder.
#   * cookie_secret is what makes a sign-in trustworthy: the roles the dashboard
#     acts on are read from that cookie, so anyone who knows the secret can forge
#     a supervisor. Generate a fresh one per deployment, keep it out of chat and
#     version control, and note that changing it signs everyone out.
#   * The client must NOT have "Direct access grants" enabled: passwords go to
#     Keycloak's own page only. keycloak/realm-nas-sentinel.json and
#     scripts/keycloak-rbac.sh set it that way.
#   * Trust for Keycloak's certificate goes under [auth.keycloak.client_kwargs]
#     as verify = "<path to the CA>"; a ca_file key is not read.
#
# If there is no [auth.keycloak] table at all (or no file), dashboard/lib/page_setup.py
# falls back to the self-declared "Operator ID / Callsign" text box, and every
# decision that operator makes is stamped `[self-declared]` in action_audit_log
# (and is refused unless ALLOW_UNVERIFIED_DECISIONS is on). A secrets.toml that
# exists but cannot be read does NOT fall back: the console shows the error and
# stops, so a typo cannot open it.
#
# The provider name in the [auth.<name>] table below ("keycloak") is the key
# dashboard/lib/login.py looks up -- don't rename that section.
#

[auth]
# Where Keycloak sends the browser back after sign-in: the dashboard as a
# BROWSER loads it, through the edge proxy, plus Streamlit's fixed callback
# path. HTTPS, and exactly the URI registered on the Keycloak client
# (keycloak/realm-nas-sentinel.json; scripts/keycloak-rbac.sh DASHBOARD_URL).
redirect_uri = "https://localhost:8443/oauth2callback"

# Any long random string; Streamlit signs its identity cookie with it, so the
# sign-in survives page loads. Changing it signs everyone out.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"

[auth.keycloak]
# Keycloak admin console -> your realm -> Clients -> create a new
# confidential client for this app -> Credentials tab.
client_id = "nas-feedops-sentinel"
client_secret = "REPLACE_WITH_CLIENT_SECRET_FROM_KEYCLOAK"

# Your realm's OIDC discovery document, over HTTPS (Keycloak serves nothing
# else, and the dashboard refuses an http:// identity URL). This URL is
# fetched by the Streamlit PROCESS itself, not the browser -- so it needs to
# resolve from wherever that process actually runs:
#   - the dashboard running AS a container on the docker-compose network
#     (the normal case) -> the service name and Keycloak's own port:
#       https://keycloak:8443/realms/<your-realm>/.well-known/openid-configuration
#   - `streamlit run` directly on your machine, against the host-mapped port ->
#       https://localhost:8081/realms/<your-realm>/.well-known/openid-configuration
server_metadata_url = "https://keycloak:8443/realms/nas-sentinel/.well-known/openid-configuration"

# Streamlit reaches the token and signing-key endpoints server to server and
# verifies Keycloak's certificate against the authority that signed it:
# tls/edge-ca.crt from src/devcert.py, mounted into the dashboard at this path.
# Remove it for an internal PKI the system trust store already trusts.
[auth.keycloak.client_kwargs]
verify = "/run/tls/edge-ca.crt"
