{
  "uid": "nas-sentinel",
  "title": "NAS FeedOps Sentinel — PCT TRACON",
  "tags": ["nas", "faa", "swim", "pct"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "HITL Queue Depth",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "nas_hitl_queue_depth", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Events Ingested (5m rate)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(nas_events_ingested_total[5m]))", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Critical Alerts (5m)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(increase(nas_alerts_triggered_total{severity=\"CRITICAL\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Validation Failure Rate",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(nas_events_validated_total{status=\"FAILED\"}[5m])) / sum(rate(nas_events_validated_total[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Alerts by Severity (per minute)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (severity) (rate(nas_alerts_triggered_total[1m]))", "legendFormat": "{{severity}}", "refId": "A"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Gate Decisions by Risk Tier",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (risk_tier) (rate(nas_gate_decisions_total[1m]))", "legendFormat": "{{risk_tier}}", "refId": "A"}]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Airport Overall Status (0=OK ... 4=DISCONNECTED)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "nas_airport_overall_status", "legendFormat": "{{airport}}", "refId": "A"}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM Call Latency (p95)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (agent, le) (rate(nas_llm_call_duration_seconds_bucket[5m])))", "legendFormat": "{{agent}} p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 109,
      "type": "row",
      "title": "Agents: GenAI conventions and AGT metrics (src/telemetry.py)",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 1},
      "collapsed": false, "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Model calls by provider and error class (gen_ai.client.operation.duration)",
      "gridPos": {"x": 0, "y": 21, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (gen_ai_provider_name, error_type) (rate(gen_ai_client_operation_duration_seconds_count[5m]))", "legendFormat": "{{gen_ai_provider_name}} {{error_type}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Model call p95 by provider",
      "gridPos": {"x": 12, "y": 21, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (gen_ai_provider_name, le) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))", "legendFormat": "{{gen_ai_provider_name}} p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Tokens per minute (gen_ai.client.token.usage)",
      "gridPos": {"x": 0, "y": 29, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (gen_ai_token_type) (rate(gen_ai_client_token_usage_sum[5m])) * 60", "legendFormat": "{{gen_ai_token_type}}", "refId": "A"}]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Model spend per hour by agent (AGT agent.sre.cost.total_usd)",
      "gridPos": {"x": 12, "y": 29, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (agent_sre_cost_agent_id) (rate(agent_sre_cost_total_usd_total[1h])) * 3600", "legendFormat": "{{agent_sre_cost_agent_id}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Agent invocations by outcome (AGT agent.tasks.total)",
      "gridPos": {"x": 0, "y": 37, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (agent_task_name, sentinel_outcome) (rate(agent_tasks_total[5m]))", "legendFormat": "{{agent_task_name}} {{sentinel_outcome}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Policy refusals (AGT agent.policy.violations)",
      "gridPos": {"x": 12, "y": 37, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (agt_audit_action, agent_policy_name) (increase(agent_policy_violations_total[15m]))", "legendFormat": "{{agt_audit_action}} {{agent_policy_name}}", "refId": "A"}]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Governed tool calls by tool and decision (AGT agent.tool_calls.total)",
      "gridPos": {"x": 0, "y": 45, "w": 24, "h": 8},
      "targets": [{"expr": "sum by (agent_tool_name, agent_policy_decision) (rate(agent_tool_calls_total[5m]))", "legendFormat": "{{agent_tool_name}} {{agent_policy_decision}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    }
  ]
}
