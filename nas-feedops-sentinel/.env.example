# NAS FeedOps Sentinel application stack. Copy to .env and fill in.
# .env is gitignored; never commit real values. docs/operations.md explains
# how these fit together.

# ── Database ─────────────────────────────────────────────────────────────────
# Schema owner: used only by the migrate job.
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel_db
# Application role used by every running service. Must equal APP_DB_PASSWORD
# in ../instraclustr/.env.
APP_DB_USER=sentinel_app
APP_DB_PASSWORD=change-me

# ── Vault ────────────────────────────────────────────────────────────────────
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=change-me

# ── Models (LiteLLM proxy aliases only; see ../instraclustr/litellm-config.yaml) ─
LLM_BASE_URL=http://nas-litellm:4000/v1
LLM_MODEL=primary-model
CRITIC_MODEL=primary-model
CRITIC_ENABLED=1
MAX_CRITIC_PER_PASS=5
INVESTIGATIONS_ENABLED=1
MAX_LLM_INVESTIGATIONS_PER_PASS=3

# ── API ──────────────────────────────────────────────────────────────────────
# /v1/ingest refuses every call without a key. API_KEYS optionally maps
# distinct secrets to named callers: {"<secret>": "ingest-service"}
API_KEY=change-me
API_KEYS=

# ── Alert thresholds (see src/config.py for provenance of each) ──────────────
LATENCY_ALERT_MS=30000
STALE_FEED_SECONDS=300
SURFACE_SPIKE_COUNT=10
SURFACE_SPIKE_WINDOW_SECONDS=60
RVR_LOW_THRESHOLD_FT=1200

# ── FAA SWIM / SCDS Jumpstart kit (from the SWIFT portal) ────────────────────
SWIM_PROVIDER_URL=tcps://your-broker.swim.faa.gov:55443
SWIM_QUEUE=your.queue.name
SWIM_CONNECTION_FACTORY=your.connection.factory
SWIM_USERNAME=your.subscription.username
SWIM_PASSWORD=change-me
SWIM_VPN=STDDS
# Where the kit writes and the watcher reads (relative to the app root).
SWIM_RAW_FOLDER=data/raw/swim_live/log

# ── Scope (docs/operations.md, "Scope") ──────────────────────────────────────────
# Left unset: the four Potomac TRACON airports. To watch other airports, name them and their TRACON.
# SUPPORTED_AIRPORTS=KJFK,KLGA,KEWR
# SUPPORTED_TRACON=N90

# ── Keycloak (scripts/Setup-Keycloak.ps1 generates the last two) ─────────────
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DASHBOARD_CLIENT_SECRET=change-me
KEYCLOAK_DB_PASSWORD=change-me

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# ── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=nas-feedops-queue
TEMPORAL_DB_USER=temporal_worker
TEMPORAL_DB_PASSWORD=change-me

LOG_LEVEL=INFO

# ── OpenTelemetry (src/telemetry.py) ─────────────────────────────────────────
# Service name on every trace, metric and log record.
OTEL_SERVICE_NAME=nas-feedops-sentinel
# Optional: also export traces, metrics and AGT's audit logs to an OTLP
# collector (Jaeger, Tempo, Azure Monitor, Datadog, Splunk, ...). Standard
# OpenTelemetry variables; per-signal OTEL_EXPORTER_OTLP_<SIGNAL>_ENDPOINT
# and OTEL_EXPORTER_OTLP_HEADERS work too. Unset: nothing is exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
