# NAS FeedOps Sentinel -- Environment Configuration Example
# Copy this file to .env and fill in real values for live SWIM mode.
# NEVER commit .env to version control.


# ── Anthropic API (Critic + Planner agents) ───────────────────────────────────
ANTHROPIC_API_KEY=
CRITIC_ENABLED=1
CRITIC_MODEL=claude-haiku-4-5-20251001

# ── LLM provider switching (anthropic | nim) ──────────────────────────────────
LLM_PROVIDER=anthropic
NIM_ENDPOINT=
NIM_MODEL=meta/llama3-8b-instruct
NIM_API_KEY=

# ── Alert Thresholds (optional overrides) ─────────────────────────────────────
LATENCY_ALERT_MS=30000
STALE_FEED_SECONDS=300
SURFACE_SPIKE_COUNT=10
SURFACE_SPIKE_WINDOW_SECONDS=60
RVR_LOW_THRESHOLD_FT=1200

# ── FAA SWIM / SCDS Jumpstart Kit Connection Details ─────────────────────────
# Obtain these values from the SWIFT portal:
#   https://portal.swim.faa.gov -> Subscription Details -> Connection Details tab
# Do NOT paste real values here. Put real values in .env (which is .gitignored).
SWIM_PROVIDER_URL=tcps://your-broker.swim.faa.gov:55443
SWIM_QUEUE=your.queue.name.from.swift.portal
SWIM_CONNECTION_FACTORY=your.connection.factory
SWIM_USERNAME=your.subscription.username
SWIM_PASSWORD=REPLACE_WITH_REAL_PASSWORD_IN_DOT_ENV
SWIM_VPN=STDDS

# ── SWIM File Ingest (swim-folder mode) ───────────────────────────────────────
# Folder where the Jumpstart JMS consumer writes raw STDDS message files.
# Directory the sentinel watcher observes for live SWIM messages.
# This is where the FAA Jumpstart Kit writes: MessageFileOutput hardcodes
# its destination to <cwd>/log/, and the kit is launched from
# data/raw/swim_live/ (see the jumpstart comment in docker-compose.yml).
# Kept relative on purpose -- resolves against WORKDIR=/app in the
# container and against the repo root for a local non-Docker run.
SWIM_RAW_FOLDER=data/raw/swim_live/log
# ── Legacy direct-connection placeholders (future use) ────────────────────────
SWIM_BROKER_URL=
SWIM_QUEUE_NAME=

# ── Keycloak OIDC Authentication ──────────────────────────────────────────────
KEYCLOAK_ADMIN_PASSWORD=change-this-to-a-long-random-password

# ── API Authentication (src/api.py, src/auth.py) ──────────────────────────────
# Leaving both unset fails /v1/ingest auth OPEN (fine for local dev only -- see
# api.py's verify_auth()). Set at least one before exposing the API beyond localhost.
# API_KEY is a single legacy shared secret; any caller presenting it is recorded in
# logs as the generic "legacy_api_key" principal.
API_KEY=
# API_KEYS optionally maps distinct secrets to named callers, so the audit trail can
# say *which* service ingested, not just "someone with a key". JSON object string:
# API_KEYS={"<secret-1>": "ingest-service", "<secret-2>": "ops-cron"}
API_KEYS=

# ── Temporal Server (workflow orchestration for src/temporal_worker.py) ───────
# temporal:7233 is the service name added in docker-compose.yml -- only change
# this if you point temporal-worker at an external Temporal deployment instead.
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=nas-feedops-queue
# Credentials for the dedicated temporal-postgresql container (NOT the main
# sentinel_db pool -- keeps Temporal's own schema isolated). Generate a real
# random value for TEMPORAL_DB_PASSWORD in your actual .env; never commit one.
TEMPORAL_DB_USER=temporal_worker
TEMPORAL_DB_PASSWORD=

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
