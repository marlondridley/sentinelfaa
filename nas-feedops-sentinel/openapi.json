{
  "openapi": "3.1.0",
  "info": {
    "title": "nas-feedops-sentinel",
    "description": "FastAPI HTTP service for NAS FeedOps Sentinel ingest workflows and health probing with authentication and correlation tracking.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Probe service readiness, active Temporal task queue, and correlation ID.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/ingest": {
      "post": {
        "summary": "Ingest Events",
        "description": "Trigger ingestion workflow via Temporal orchestrator. Supports direct event payload or directory scan.",
        "operationId": "ingest_ingest_post",
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Workflow Triggered Successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "workflow_id": {
                      "type": "string"
                    },
                    "correlation_id": {
                      "type": "string"
                    },
                    "task_queue": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "workflow_id",
                    "correlation_id",
                    "task_queue"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing authentication credentials"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "503": {
            "description": "Temporal Engine Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IngestRequest": {
        "properties": {
          "events": {
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "type": "array",
            "title": "Events",
            "default": []
          },
          "label": {
            "type": "string",
            "title": "Label",
            "default": "API"
          },
          "source_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Dir",
            "default": null
          }
        },
        "type": "object",
        "title": "IngestRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "type": "object",
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Custom API Key authentication header"
      },
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token authentication"
      }
    }
  }
}
