# ── Python runtime ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.jar
# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Credentials and secrets -- NEVER commit these ────────────────────────────
.env
*.properties
config/*local*
config/*secret*

# ── FAA SWIM / SCDS Jumpstart Kit output ─────────────────────────────────────
# Raw STDDS messages from the Jumpstart consumer are operational data.
# They may contain sensitive NAS traffic information.
# The app's data dirs live under nas-feedops-sentinel/, and a pattern with a
# slash in it is anchored to this file's directory -- so these rules used to
# match only a (nonexistent) top-level data/, and every live FAA SWIM capture,
# processed file and SQLite db under nas-feedops-sentinel/data/ was committable.
# The **/ prefix makes them match at any depth.
**/data/raw/swim_live/*
!**/data/raw/swim_live/.gitkeep
!**/data/raw/swim_live/log/
**/data/raw/swim_live/log/*
!**/data/raw/swim_live/log/.gitkeep
instraclustr/temporal_binary/temporal.exe
instraclustr/jars/kafka-connect-elastic6-1.2.3-2.1.0-all.tar.gz
instraclustr/cassandra-kafka-elasticsearch-open-source/plugins/*
# Vault operator-init output (root token + unseal key) -- see
# instraclustr/vault-unseal-and-seed.bash. Whoever holds this file can
# unseal Vault and read every secret in it; it must never be committed.
instraclustr/vault-init-data/*
# ── Processed and failed ingest files ────────────────────────────────────────
**/data/processed/*
!**/data/processed/.gitkeep
**/data/failed/*
!**/data/failed/.gitkeep

# ── SQLite database ───────────────────────────────────────────────────────────
**/data/feedops.db
**/data/*.db

# ── Replay files (generated; not source) ─────────────────────────────────────
# Comment this out if you want to commit specific replay fixtures.
**/data/raw/sample_*.json

# ── IDE and OS files ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Pytest / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Streamlit cache ───────────────────────────────────────────────────────────
# Ignore everything under any .streamlit/ dir at any depth (real
# secrets.toml lives there) EXCEPT the checked-in sanitized example
# template, so operators spinning up the dashboard locally can find the
# expected file shape. Must use **/ (not a bare leading slash) so this
# still matches nas-feedops-sentinel/.streamlit/, not just a top-level
# .streamlit/ in the repo root -- a plain "middle-slash" pattern like
# ".streamlit/*" is anchored to this .gitignore's own directory and
# would silently stop matching the nested one.
**/.streamlit/*
!**/.streamlit/secrets.toml.example
# config.toml carries only the theme tokens (no credentials) and has to
# be in the repo: it is bind-mounted into the dashboard container and is
# what colours every Streamlit widget, so an operator cloning this repo
# without it gets the default light-on-grey theme under a dark stylesheet.
!**/.streamlit/config.toml
datarawswim_live/
jumpstart-latest/
*.zip

# The FAA SCDS Jumpstart Kit (L3Harris). Its LICENSE is a restricted-rights
# notice, so the kit is not redistributed: everything under jumpstart/ is
# ignored except our own two files, the live launcher and the ingest writer.
# Download the kit from SCDS and unpack it over nas-feedops-sentinel/jumpstart/.
# (`**/` re-includes the directories so git can reach the two files.)
nas-feedops-sentinel/jumpstart/**
!nas-feedops-sentinel/jumpstart/**/
!nas-feedops-sentinel/jumpstart/run-live.ps1
!nas-feedops-sentinel/jumpstart/src/main/java/com/harris/cinnato/outputs/IngestFolderFileOutput.java

# ── Local Claude Code settings (per-developer, never shared) ──────────────────
.claude/settings.local.json

# Local container diagnostics (scripts/Collect-Diagnostics.ps1) -- may contain log output
**/diagnostics.txt

# Local tools and scratch output, not part of this project:
# llm-wiki/ is a separate third-party repository (its own .git) whose wiki/
# is generated from local Claude Code sessions.
llm-wiki/
Claude outputs/

# Edge TLS certificate and key (generated by src/devcert.py)
nas-feedops-sentinel/tls/

# Vault recovery key share 3: move off this machine, never commit
instraclustr/vault-recovery/

# Workload-identity PKI (instraclustr/certs/README.md): per environment,
# never committed. Only the CA policy and the README are source.
instraclustr/certs/*
!instraclustr/certs/policy/
!instraclustr/certs/README.md

# Terraform: local state and provider cache. State holds no secrets here
# (policies, roles, the public root) but belongs to one deployment.
instraclustr/terraform/.terraform/
instraclustr/terraform/*.tfstate
instraclustr/terraform/*.tfstate.*
instraclustr/terraform/*.tfplan

# The operator's ceremony workspace (step scripts, filled-in record sheet):
# local to this machine. The tracked procedure is instraclustr/README.md,
# "First-time setup", and instraclustr/certs/README.md.
ceremony/
