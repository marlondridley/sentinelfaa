# Infrastructure stack (Postgres, PgBouncer, Vault, LiteLLM).
# Copy to .env and fill in. .env is gitignored; never commit real values.

# ── Postgres (schema owner) ───────────────────────────────────────────────────
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel_db

# ── Application database role (DML only) ──────────────────────────────────────
# Seeded into Vault at secret/postgres/app, which is the only place the
# application stack gets it from (the migrate job creates the role with it).
APP_DB_USER=sentinel_app
APP_DB_PASSWORD=change-me

# ── Vault ─────────────────────────────────────────────────────────────────────
# Nothing here: Vault is TLS-only against the offline root (certs/README.md),
# no root token is stored anywhere, and policy changes go through the root
# ceremony (terraform/ceremony.sh). See README.md.

# ── SPIRE (workload identity) ────────────────────────────────────────────────
# spire-agent's first boot only: a one-time join token (README.md, "SPIRE:
# first boot"). Remove it after that boot -- a restart reuses the agent's
# cached identity and ignores this.
SPIRE_JOIN_TOKEN=

# ── LiteLLM proxy and upstream providers ─────────────────────────────────────
# The master key stays with the proxy. The application gets a scoped virtual
# key (litellm-bootstrap.sh): primary-model only, with a 30-day budget and a
# rate limit.
LITELLM_APP_BUDGET_USD=10
LITELLM_APP_RPM=30
#
# Not here any more: the gateway's three secrets live in Vault, at
# secret/litellm, and reach it through its own Vault Agent (README.md,
# "Gateway secrets"):
#   ANTHROPIC_API_KEY    the Claude API service-account key, scoped to the
#                        sentinelfaa workspace; the only provider key
#   LITELLM_MASTER_KEY   the proxy's admin key; generated if Vault has none
#   LITELLM_DB_PASSWORD  the litellm database role's; generated if Vault has none
# Moving an existing stack (one time): leave the old values in this file for
# exactly one start, so the seed job copies them into Vault (it never
# overwrites a value Vault already has), then delete them from this file. A new
# install does the same with ANTHROPIC_API_KEY alone: put it here for the first
# start, then delete it. Changing one later (rotation) is a root task, done by
# a person: README.md, "Gateway secrets".

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change-me

# ── Alerting (nas-feedops-sentinel/docs/runbooks.md, "Alerts are not reaching Slack") ─
# A Slack Incoming Webhook URL: Alertmanager posts every alert to its channel. A secret:
# anyone who has it can post there. Empty: alerts are held and shown in Alertmanager
# (https://localhost:8448) and nothing is sent. The Slack app's client secret, signing
# secret and tokens are not used by anything here and do not belong in this file.
SLACK_WEBHOOK_URL=

# ── Public access (nas-feedops-sentinel/docs/public-access.md) ───────────────
# The Cloudflare tunnel's connector token. Only `launch_nas_sentinel.ps1 -Public`
# starts the tunnel; leave empty to keep the site private.
CLOUDFLARE_TUNNEL_TOKEN=
