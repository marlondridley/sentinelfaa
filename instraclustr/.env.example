# Infrastructure stack (Postgres, PgBouncer, Vault, LiteLLM).
# Copy to .env and fill in. .env is gitignored; never commit real values.

# ── Postgres (schema owner) ───────────────────────────────────────────────────
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel_db

# ── Application database role (DML only) ──────────────────────────────────────
# Seeded into Vault at secret/postgres/app. Must equal APP_DB_PASSWORD in
# ../nas-feedops-sentinel/.env (the migrate job creates the role with it).
APP_DB_USER=sentinel_app
APP_DB_PASSWORD=change-me

# ── Vault ─────────────────────────────────────────────────────────────────────
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=change-me

# ── LiteLLM proxy and upstream providers ─────────────────────────────────────
# The application currently authenticates with the master key (seeded into
# Vault as secret/sentinel/config LITELLM_API_KEY). Temporary: move to a
# scoped virtual key once LiteLLM has a database.
LITELLM_MASTER_KEY=sk-change-me
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change-me
